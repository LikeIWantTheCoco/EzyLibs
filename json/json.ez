# ── json: read, build and modify JSON from Ezy ────────────────
# Values are opaque integer handles. 0 is the null handle (missing /
# parse error). A parsed document owns its whole tree — free the root
# with json_free; child handles from json_get / json_at are borrowed.

# ── Parse / serialize ─────────────────────────────────
extern fn json_parse(s: string) -> int          # JSON text -> handle (0 on error)
extern fn json_stringify(h: int) -> string        # handle -> compact JSON text
extern fn json_pretty(h: int) -> string            # handle -> indented JSON text
extern fn json_load(path: string) -> int           # parse a file -> handle
extern fn json_save(h: int, path: string) -> int   # write compact JSON (1 ok)
extern fn json_save_pretty(h: int, path: string) -> int

# ── Type inspection ───────────────────────────────────
extern fn json_type(h: int) -> string              # null|bool|number|string|array|object
extern fn json_is_null(h: int) -> int
extern fn json_is_object(h: int) -> int
extern fn json_is_array(h: int) -> int
extern fn json_is_number(h: int) -> int
extern fn json_is_string(h: int) -> int
extern fn json_is_bool(h: int) -> int

# ── Leaf value extraction ─────────────────────────────
extern fn json_int(h: int) -> int
extern fn json_float(h: int) -> float
extern fn json_bool(h: int) -> int
extern fn json_string(h: int) -> string

# ── Object access ─────────────────────────────────────
extern fn json_get(h: int, key: string) -> int     # object[key] -> handle (0 if missing)
extern fn json_has(h: int, key: string) -> int
extern fn json_size(h: int) -> int                  # key count (object) / length (array)
extern fn json_key_at(h: int, i: int) -> string     # i-th key of an object (iteration)

# convenience: fetch + extract in one call
extern fn json_get_string(h: int, key: string) -> string
extern fn json_get_int(h: int, key: string) -> int
extern fn json_get_float(h: int, key: string) -> float
extern fn json_get_bool(h: int, key: string) -> int

# ── Array access ──────────────────────────────────────
extern fn json_at(h: int, i: int) -> int            # array[i] -> handle
extern fn json_len(h: int) -> int                   # array length

# ── Construction ──────────────────────────────────────
extern fn json_object() -> int                      # new empty object
extern fn json_array() -> int                       # new empty array
extern fn json_new_string(s: string) -> int
extern fn json_new_int(n: int) -> int
extern fn json_new_float(x: float) -> int
extern fn json_new_bool(b: int) -> int
extern fn json_null() -> int

# ── Mutation (the container takes ownership of val) ────
extern fn json_set(obj: int, key: string, val: int) -> int
extern fn json_set_string(obj: int, key: string, s: string) -> int
extern fn json_set_int(obj: int, key: string, n: int) -> int
extern fn json_set_float(obj: int, key: string, x: float) -> int
extern fn json_set_bool(obj: int, key: string, b: int) -> int
extern fn json_remove(obj: int, key: string) -> int
extern fn json_append(arr: int, val: int) -> int
extern fn json_append_string(arr: int, s: string) -> int
extern fn json_append_int(arr: int, n: int) -> int
extern fn json_append_float(arr: int, x: float) -> int
extern fn json_append_bool(arr: int, b: int) -> int

# ── Cleanup ───────────────────────────────────────────
extern fn json_free(h: int) -> int
