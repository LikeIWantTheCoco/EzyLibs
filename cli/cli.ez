# ════════════════════════════════════════════════════════════════
#  cli  —  reactive terminal UI for Ezy
#  import cli
# ════════════════════════════════════════════════════════════════
#
#  REACTIVE VARIABLES  (named values pinned to a screen position)
#  ┌─────────────────────────────────────────────────────────────┐
#  │  Name = cli_var("Name", "hello")   # declare + set value   │
#  │  cli_print(Name)                   # draw at cursor         │
#  │  cli_set(Name, "world")            # redraw in place        │
#  └─────────────────────────────────────────────────────────────┘
#
#  SAME-LINE LAYOUT
#  ┌─────────────────────────────────────────────────────────────┐
#  │  cli_print_inline(A)               # no \n, cursor stays   │
#  │  cli_print_inline(B)               # anchors right of A    │
#  │  cli_newline()                     # end the line          │
#  │  cli_set(A, "new")                 # A updates in place    │
#  └─────────────────────────────────────────────────────────────┘
#
#  QUICK REFERENCE
#   Styling    cli_color  cli_bold  cli_dim
#   Layout     cli_divider  cli_center  cli_ljust  cli_rjust
#   Box        cli_make_box(content, frame_color, chars, padding)
#   UI         cli_section  cli_title  cli_alert  cli_status  cli_badge
#   Input      cli_ask  cli_confirm  cli_inputbox
#   Widgets    cli_progress  cli_spinner  cli_picker

# ── Reactive variables ───────────────────────────────────────────
extern fn cli_var(name: string, value: string = "") -> string
extern fn cli_set(name: string, value: string) -> int
extern fn cli_get(name: string) -> string
extern fn cli_print(name: string) -> int
extern fn cli_print_inline(name: string) -> int   # no newline — next var on same line
extern fn cli_text(text: string) -> int           # print a plain line (adds \n)
extern fn cli_newline() -> int
extern fn cli_hide(name: string) -> int
extern fn cli_show(name: string) -> int
extern fn cli_replace(name: string, other: string) -> int
extern fn cli_remove(name: string) -> int

# ── Screen / cursor ──────────────────────────────────────────────
extern fn cli_clear() -> int
extern fn cli_cursor_hide() -> int
extern fn cli_cursor_show() -> int
extern fn cli_cursor_up(n: int) -> int
extern fn cli_cursor_down(n: int) -> int
extern fn cli_move(row: int, col: int) -> int
extern fn cli_term_width() -> int     # live terminal column count (fallback 80)
extern fn cli_term_height() -> int    # live terminal row count    (fallback 24)

# ── Styling  (return styled strings) ────────────────────────────
# colors: red  green  yellow  blue  magenta  cyan  white  grey
extern fn cli_color(text: string, color: string) -> string
extern fn cli_bold(text: string) -> string
extern fn cli_dim(text: string) -> string

# ── Layout helpers  (return strings) ────────────────────────────
extern fn cli_divider(ch: string, n: int) -> string
# repeat glyph n times  →  cli_divider("─", 40)

extern fn cli_center(text: string, width: int) -> string
extern fn cli_ljust(text: string, width: int) -> string
extern fn cli_rjust(text: string, width: int) -> string
# align text in width columns (pad with spaces)

# ── Box  ─────────────────────────────────────────────────────────
# chars: 5 glyphs "tl h tr bl br"  or  6 "tl h tr v bl br"
#        ""  →  default "┌─┐│└┘"
# padding: extra spaces/rows inside the frame (0 = tight)
extern fn cli_make_box(content: string, frame_color: string, chars: string, padding: int) -> string
# example:
#   title = cli_bold(cli_color("My App", "white"))
#   cli_text(cli_make_box(title, "blue", "╔═╗║╚╝", 1))

# ── UI components  (return strings) ──────────────────────────────
extern fn cli_section(title: string, color: string) -> string
# full-width section header: ─── / bold title / ───
# cli_text(cli_section("Setup", "cyan"))

extern fn cli_title(text: string, color: string) -> string
# centered title with ─── on each side (single line)
# cli_text(cli_title("Results", "yellow"))

extern fn cli_alert(text: string, kind: string) -> string
# colored alert with icon.  type: "info" | "warn" | "error" | "success"
# cli_text(cli_alert("file not found", "error"))

extern fn cli_status(label: string, ok: int) -> string
# ✓ label  (green) or  ✗ label  (red)
# cli_text(cli_status("tests pass", 1))

extern fn cli_badge(text: string, color: string) -> string
# bold colored [badge]

# ── Input ─────────────────────────────────────────────────────────
extern fn cli_ask(prompt: string) -> string
# simple inline prompt + readline  (no box)
# name = cli_ask("Your name: ")

extern fn cli_confirm(question: string) -> int
# y/N prompt — returns 1 for yes, 0 for no
# if cli_confirm("Continue?") == 1: { ... }

extern fn cli_inputbox(prompt: string, width: int, frame_color: string) -> string
# framed input: draws top/bottom borders, reads in the middle
# width=0 → terminal width - 4.  frame_color="" → no color
# answer = cli_inputbox("> ", 0, "blue")

# ── Widgets  (stored in a cli_var, updated reactively) ───────────
# picker: options = newline-separated list, dir = "vertical" | "horizontal"
extern fn cli_picker(name: string, dir: string, options: string) -> string
extern fn cli_picker_up(name: string) -> int
extern fn cli_picker_down(name: string) -> int
extern fn cli_picker_select(name: string, i: int) -> int
extern fn cli_picker_index(name: string) -> int
extern fn cli_picker_value(name: string) -> string

extern fn cli_progress(name: string, percent: int, width: int) -> int
# cli_progress("Bar", 75, 40)  then  cli_print("Bar")

extern fn cli_spinner(name: string) -> int
# call repeatedly in a loop to advance one frame

# ── Interactive menu  (blocking arrow-key chooser) ───────────────
extern fn cli_menu(title: string, options: string) -> int
# ↑/↓ (or k/j) to move, Enter to pick, q/Esc to cancel (-1).
# returns the selected 0-based index. options = newline-separated list.
# i = cli_menu("Pick:", "Apple\nBanana\nCherry")

# ════════════════════════════════════════════════════════════════
#  EASY API — short, python-like helpers built on the extern fns
#  above. Names are unprefixed for ergonomics; importing cli brings
#  them into scope, so avoid shadowing them in your own program.
# ════════════════════════════════════════════════════════════════

# ── Style  (return styled strings — compose freely: bold(red("x"))) ─
fn bold(s: string) -> string:    { return cli_bold(s) }
fn dim(s: string) -> string:     { return cli_dim(s) }
fn red(s: string) -> string:     { return cli_color(s, "red") }
fn green(s: string) -> string:   { return cli_color(s, "green") }
fn yellow(s: string) -> string:  { return cli_color(s, "yellow") }
fn blue(s: string) -> string:    { return cli_color(s, "blue") }
fn magenta(s: string) -> string: { return cli_color(s, "magenta") }
fn cyan(s: string) -> string:    { return cli_color(s, "cyan") }
fn white(s: string) -> string:   { return cli_color(s, "white") }
fn grey(s: string) -> string:    { return cli_color(s, "grey") }

# ── Output  (print a whole line) ─────────────────────────────────
fn say(text: string):            { cli_text(text) }              # like print, via cli
fn br():                         { cli_newline() }               # blank line
fn error(msg: string):           { cli_text(cli_alert(msg, "error")) }
fn warn(msg: string):            { cli_text(cli_alert(msg, "warn")) }
fn info(msg: string):            { cli_text(cli_alert(msg, "info")) }
fn ok(msg: string):              { cli_text(cli_alert(msg, "success")) }
fn rule(color: string = "grey"): { cli_text(cli_color(cli_divider("─", cli_term_width()), color)) }
fn heading(title: string, color: string = "cyan"): { cli_text(cli_section(title, color)) }
fn box(text: string, color: string = "cyan"):      { cli_text(cli_make_box(text, color, "", 1)) }

# ── Input  (python-like prompts) ─────────────────────────────────
fn ask(prompt: string) -> string:   { return cli_ask(prompt) }
fn confirm(question: string) -> bool: { return cli_confirm(question) == 1 }

# choose: interactive menu that returns the picked option text ("" if cancelled)
fn choose(title: string, options: string) -> string:
{
    i = cli_menu(title, options)
    if i < 0:
    {
        return ""
    }
    parts = options.split("\n")
    return parts[i]
}

# ── Keyboard events  (press a key → run a function) ──────────────
# cli_read_key() blocks for one keypress and returns its name:
#   "up" "down" "left" "right" "enter" "esc" "space" "tab" "backspace"
#   or the literal character ("a", "1", ...).  "" on EOF.
extern fn cli_read_key() -> string

# dispatch: run every callback whose key matches `key`.
# keys[i] is bound to cbs[i] (a fn() value). example:
#   dispatch("up", ["up","down"], [arrow, go_down])
fn dispatch<T>(key: string, keys: [string], cbs: [T]):
{
    _i = 0
    _n = keys.len()
    while _i < _n:
    {
        if keys[_i] == key:
        {
            _f = cbs[_i]
            _f()
        }
        _i = _i + 1
    }
}

# listen_until: read keys forever and fire the matching callback, until the
# `quit` key is pressed or input ends. Hides the cursor during the loop.
#   listen_until(["up"], [arrow], "q")    # press q to stop
fn listen_until<T>(keys: [string], cbs: [T], quit: string):
{
    cli_cursor_hide()
    _running = true
    while _running:
    {
        _k = cli_read_key()
        if _k == quit or _k == "":
        {
            _running = false
        }
        else:
        {
            dispatch(_k, keys, cbs)
        }
    }
    cli_cursor_show()
}

# listen: same, quitting on Esc. Bind keys to functions with two parallel
# arrays — keys[i] runs cbs[i] when pressed:
#
#   fn arrow():  { say("up!") }
#   fn down():   { say("down!") }
#   listen(["up", "down"], [arrow, down])      # press Esc to quit
fn listen<T>(keys: [string], cbs: [T]):
{
    listen_until(keys, cbs, "esc")
}
