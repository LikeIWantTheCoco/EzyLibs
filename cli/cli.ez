# ── cli: reactive terminal UI for Ezy ─────────────────────────
# CLI variables are named string values pinned to a screen position.
# cli_print(name) draws a variable and remembers where; cli_set(name,
# value) then redraws it in place — no reprint, no flicker. Templates
# (picker, progress, spinner, box) render into a variable's value, so
# updating them re-renders automatically.
#
#   cli_set("Greeting", "Hola")     # not shown yet
#   cli_print("Greeting")           # shows "Hola"
#   cli_set("Greeting", "Adios")    # the on-screen "Hola" becomes "Adios"

# ── Reactive variables ────────────────────────────────
# Declare a variable once; cli_var returns its name, so you keep an Ezy
# handle and pass it around (no string literals everywhere):
#     Example = cli_var("Example")
#     cli_set(Example, "Hola")
#     cli_print(Example)
#     cli_set(Example, "Adios")     # the on-screen text updates in place
extern fn cli_var(name: string) -> string               # declare -> returns the handle
extern fn cli_set(name: string, value: string) -> int   # set/update (redraws if shown)
extern fn cli_get(name: string) -> string
extern fn cli_print(name: string) -> int                 # draw at cursor, remember position
extern fn cli_hide(name: string) -> int                  # blank the region (keeps layout)
extern fn cli_show(name: string) -> int                  # show again after hide
extern fn cli_replace(name: string, other: string) -> int  # show other's value in name's region
extern fn cli_remove(name: string) -> int                # clear region and forget

# ── Screen / cursor ───────────────────────────────────
extern fn cli_clear() -> int
extern fn cli_cursor_hide() -> int
extern fn cli_cursor_show() -> int
extern fn cli_move(row: int, col: int) -> int

# ── Styling (return styled strings to use as values) ──
extern fn cli_color(text: string, color: string) -> string  # red green yellow blue magenta cyan white grey
extern fn cli_bold(text: string) -> string
extern fn cli_dim(text: string) -> string
extern fn cli_box(text: string) -> string                   # draw a box → multi-line string

# ── Templates ─────────────────────────────────────────
# picker: options is a newline-separated list; dir is "vertical" or "horizontal"
# returns the picker's handle:  Menu = cli_picker("Menu", "vertical", "A\nB\nC")
extern fn cli_picker(name: string, dir: string, options: string) -> string
extern fn cli_picker_up(name: string) -> int        # move selection up   (returns new index)
extern fn cli_picker_down(name: string) -> int      # move selection down
extern fn cli_picker_select(name: string, i: int) -> int
extern fn cli_picker_index(name: string) -> int     # selected index
extern fn cli_picker_value(name: string) -> string  # selected option text

extern fn cli_progress(name: string, percent: int, width: int) -> int  # progress bar
extern fn cli_spinner(name: string) -> int           # advance a spinner one frame
