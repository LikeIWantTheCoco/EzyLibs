# ── cli: reactive terminal UI for Ezy ─────────────────────────
# CLI variables are named string values pinned to a screen position.
# cli_print(name) draws a variable and remembers where; cli_set(name,
# value) then redraws it in place — no reprint, no flicker. Templates
# (picker, progress, spinner, box) render into a variable's value, so
# updating them re-renders automatically.
#
#   cli_set("Greeting", "Hola")     # not shown yet
#   cli_print("Greeting")           # shows "Hola"
#   cli_set("Greeting", "Adios")    # the on-screen "Hola" becomes "Adios"

# ── Reactive variables ────────────────────────────────
# Declare a variable (optionally with its initial value); cli_var returns
# its name, so you keep an Ezy handle and pass it around:
#     Example = cli_var("Example", "Hola")   # declare + set content
#     cli_print(Example)
#     cli_set(Example, "Adios")              # updates in place
# The value is optional:  Example = cli_var("Example")
extern fn cli_var(name: string, value: string = "") -> string
extern fn cli_set(name: string, value: string) -> int   # set/update (redraws if shown)
# Plain (non-reactive) output — for static lines/spacing. Do NOT use
# cli_print for literal text: cli_print expects a variable NAME.
extern fn cli_text(text: string) -> int                  # print a literal line
extern fn cli_newline() -> int                           # a blank line
extern fn cli_get(name: string) -> string
extern fn cli_print(name: string) -> int                 # draw at cursor, remember position
extern fn cli_print_inline(name: string) -> int          # draw without newline — next inline var on same line
extern fn cli_hide(name: string) -> int                  # blank the region (keeps layout)
extern fn cli_show(name: string) -> int                  # show again after hide
extern fn cli_replace(name: string, other: string) -> int  # show other's value in name's region
extern fn cli_remove(name: string) -> int                # clear region and forget

# ── Screen / cursor ───────────────────────────────────
extern fn cli_clear() -> int
extern fn cli_cursor_hide() -> int
extern fn cli_cursor_show() -> int
extern fn cli_cursor_up(n: int) -> int    # move cursor up n lines (relative)
extern fn cli_cursor_down(n: int) -> int  # move cursor down n lines (relative)
extern fn cli_move(row: int, col: int) -> int

# ── Terminal size ──────────────────────────────────────
extern fn cli_term_width() -> int         # current terminal column count (fallback: 80)
extern fn cli_term_height() -> int        # current terminal row count    (fallback: 24)

# ── Styling (return styled strings to use as values) ──
extern fn cli_color(text: string, color: string) -> string  # red green yellow blue magenta cyan white grey
extern fn cli_bold(text: string) -> string
extern fn cli_dim(text: string) -> string
extern fn cli_make_box(content: string, frame_color: string, chars: string, padding: int) -> string
# wrap pre-styled content in a colored frame with custom box chars and padding.
# chars: 5 glyphs "tl h tr bl br"  or  6 glyphs "tl h tr v bl br". "" = default "┌─┐│└┘"
# padding: spaces added left/right and blank rows added top/bottom inside the box
# example: cli_make_box(cli_color("Hi","white"), "blue", "╔═╗║╚╝", 1)

# ── Layout helpers (return strings) ───────────────────
extern fn cli_divider(ch: string, n: int) -> string   # repeat glyph n times: cli_divider("─", 40)
extern fn cli_center(text: string, width: int) -> string  # center in width columns
extern fn cli_ljust(text: string, width: int) -> string   # left-align, pad right with spaces
extern fn cli_rjust(text: string, width: int) -> string   # right-align, pad left with spaces

# ── UI components ──────────────────────────────────────
extern fn cli_status(label: string, ok: int) -> string    # ✓/✗ colored status: cli_status("tests pass", 1)
extern fn cli_badge(text: string, color: string) -> string # bold colored [badge]

# ── Input template ─────────────────────────────────────
# draw top/bottom borders, position cursor in middle, read a line, return it.
# width=0 → terminal width - 4.  frame_color="" → no color.
extern fn cli_inputbox(prompt: string, width: int, frame_color: string) -> string

# ── Templates ─────────────────────────────────────────
# picker: options is a newline-separated list; dir is "vertical" or "horizontal"
# returns the picker's handle:  Menu = cli_picker("Menu", "vertical", "A\nB\nC")
extern fn cli_picker(name: string, dir: string, options: string) -> string
extern fn cli_picker_up(name: string) -> int        # move selection up   (returns new index)
extern fn cli_picker_down(name: string) -> int      # move selection down
extern fn cli_picker_select(name: string, i: int) -> int
extern fn cli_picker_index(name: string) -> int     # selected index
extern fn cli_picker_value(name: string) -> string  # selected option text

extern fn cli_progress(name: string, percent: int, width: int) -> int  # progress bar
extern fn cli_spinner(name: string) -> int           # advance a spinner one frame
