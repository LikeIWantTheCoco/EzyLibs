# ── os: operating-system utilities for Ezy ────────────────────
# Environment, processes, filesystem and path helpers. The filesystem
# and path functions used to be native; they now live here to keep the
# runtime small. Flat functions, Python-os style.
#
#   import "os"
#   fn main():
#   {
#       print(os_platform(), os_arch())     # linux x86_64
#       os_write("/tmp/x.txt", "hi\n")
#       lines = os_read("/tmp/x.txt").split("\n")   # iterate a string array
#       for line in lines: { print(line) }
#       print(os_run_capture("echo hello"))
#   }

# ── environment ──
extern fn os_getenv(name: string) -> string         # "" if unset
extern fn os_setenv(name: string, value: string) -> int
extern fn os_unsetenv(name: string) -> int
extern fn os_environ() -> string                    # newline-separated KEY=VALUE
extern fn os_homedir() -> string                    # the user's home dir
extern fn os_tmpdir() -> string                     # system temp dir
extern fn os_user() -> string                       # current username

# ── processes ──
extern fn os_run(cmd: string) -> int                # run shell cmd -> exit status
extern fn os_run_capture(cmd: string) -> string     # run cmd -> its stdout
extern fn os_pid() -> int
extern fn os_ppid() -> int
extern fn os_hostname() -> string
extern fn os_platform() -> string                   # "linux" / "darwin" / "windows"
extern fn os_arch() -> string                       # "x86_64" / "aarch64" / ...

# ── directories / cwd ──
extern fn os_getcwd() -> string
extern fn os_chdir(path: string) -> int
extern fn os_mkdir(path: string) -> int
extern fn os_mkdirs(path: string) -> int            # create parents too (mkdir -p)
extern fn os_rmdir(path: string) -> int             # recursive (rm -rf)
extern fn os_listdir(path: string) -> string        # newline-separated names
extern fn os_glob(pattern: string) -> string        # glob matches, newline-separated

# ── files ──
extern fn os_read(path: string) -> string
extern fn os_write(path: string, content: string) -> int
extern fn os_append(path: string, content: string) -> int
extern fn os_delete(path: string) -> int
extern fn os_copy(src: string, dst: string) -> int
extern fn os_move(src: string, dst: string) -> int
extern fn os_touch(path: string) -> int
extern fn os_filesize(path: string) -> int
extern fn os_tempfile() -> string                   # create a unique temp file -> its path
extern fn os_chmod(path: string, octal: string) -> int   # e.g. os_chmod(f, "755")
extern fn os_access(path: string, mode: string) -> int   # mode = any of "rwx"; 1 if allowed

# ── symbolic links ──
extern fn os_symlink(target: string, linkpath: string) -> int
extern fn os_readlink(path: string) -> string
extern fn os_islink(path: string) -> int

# ── path queries ──
extern fn os_exists(path: string) -> int
extern fn os_isfile(path: string) -> int
extern fn os_isdir(path: string) -> int
extern fn os_isabs(path: string) -> int
extern fn os_mtime(path: string) -> int

# ── path manipulation ──
extern fn os_dirname(path: string) -> string
extern fn os_basename(path: string) -> string
extern fn os_path_join(a: string, b: string) -> string
extern fn os_path_ext(path: string) -> string
extern fn os_path_stem(path: string) -> string
extern fn os_abspath(path: string) -> string
extern fn os_normpath(path: string) -> string       # collapse // . .. lexically
extern fn os_relpath(target: string, base: string) -> string

extern fn os_version() -> string

# For string arrays, split the result on a variable (this keeps the string
# element type, which is lost across a function-return boundary):
#   names = os_listdir(".").split("\n")
#   lines = os_read("f.txt").split("\n")
#   for x in names: { print(x) }
