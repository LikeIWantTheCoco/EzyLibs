{
  "name":         "swiss",
  "version":      "0.3.0",
  "type":         "tool",
  "description":  "Swiss — one React/JSX frontend + Ezy backend, many native targets: web (react-reconciler → DOM), desktop GTK (linux/macos), native Win32 (windows), and Android (JSX → Kotlin + JNI backend). Decoupled codegen core with per-target backends + the swiss CLI.",
  "assets": [
    "swiss.js",
    "swiss-reconciler.js",
    "swiss-host-web.js",
    "swiss-components.js",
    "swiss-stylesheet.js",
    "swiss-theme.mjs",
    "swiss-bridge.js",
    "swiss-jsx-core.mjs",
    "swiss-c-backend.mjs",
    "swiss-kt-backend.mjs",
    "swiss-gtkc.mjs",
    "swiss-win32c.mjs",
    "swiss-androidc.mjs",
    "swiss-sig.mjs",
    "swiss-winsdk.mjs",
    "swiss-winshim.c",
    "swiss-native.ez",
    "swiss-native.js",
    "assets/fonts/DejaVuSans.ttf",
    "assets/fonts/DejaVuSans-Bold.ttf"
  ],
  "cli":          "swiss",
  "tool_source":  "swiss.sh",
  "dependencies": [
    "os", "os_ui", "os_notify", "os_clipboard", "os_screen", "os_open",
    "os_power", "os_brightness", "os_permissions", "os_gps", "os_sensors",
    "os_background"
  ]
}
